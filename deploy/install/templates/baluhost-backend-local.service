[Unit]
Description=BaluHost backend (local channel, Unix socket)
Requires=baluhost-backend-local.socket
After=baluhost-backend-local.socket network.target postgresql.service

[Service]
Type=simple
User=@@BALUHOST_USER@@
Group=@@BALUHOST_USER@@
WorkingDirectory=@@INSTALL_DIR@@/backend
EnvironmentFile=@@INSTALL_DIR@@/.env.production
Environment="BALUHOST_CHANNEL=local"
# The local channel never owns the hardware loops (#710). The app already
# refuses the primary role when BALUHOST_CHANNEL=local (core/lifespan.py,
# _try_become_primary); this line says so where an operator looks first, and
# replaces the drop-in primary-worker.conf that used to exist on the box only.
Environment="BALUHOST_PRIMARY_WORKER=0"
# Socket-activated: systemd passes the listening socket as fd 3
# (baluhost-backend-local.socket). Enable the SOCKET, not this service.
ExecStart=@@VENV_BIN@@/uvicorn app.main:app \
    --fd 3 \
    --workers 2 \
    --log-level info
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
